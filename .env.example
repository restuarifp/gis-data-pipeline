# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Metabase
MB_DB_USER=
MB_DB_PASS=

# DBT
DBT_POSTGRES_USER=
DBT_POSTGRES_PW=
DBT_POSTGRES_DB=
DBT_POSTGRES_HOST=

# OnlyOffice
JWT_SECRET=

# Nextcloud WebDAV + database (excel-loader: finance.xlsx -> raw_finance_* langsung)
NEXTCLOUD_URL=https://cloud.example.com
NEXTCLOUD_USER=
NEXTCLOUD_PASSWORD=
NEXTCLOUD_SOURCE_HOME=/Uploads/Finance    # folder induk; entri di bawah ditulis relatif terhadap ini
NEXTCLOUD_SOURCE_PATHS=A1/Finance,A2/Finance  # koma-separated; kantor_id = folder di atas 'Finance' (A1 -> a1)
# NEXTCLOUD_SOURCE_PATH juga diterima (alias, untuk satu atau beberapa path)
# Path lengkap tetap boleh (join-nya idempoten). NEXTCLOUD_SOURCE_HOME juga membatasi
# folder yang boleh diminta lewat argumen /load di Telegram — isi sesempit mungkin.
# NEXTCLOUD_DEST_PATH tidak dipakai lagi (tidak ada file split yang di-upload).
SCHEDULE_INTERVAL_MINUTES=60             # interval run (menit); pengganti jadwal koneksi Airbyte finance
LOAD_DB_HOST=postgres-db                 # warehouse tujuan; default cocok dengan compose stack ini
LOAD_DB_PORT=5432
LOAD_DB_NAME=capil_db
LOAD_DB_USER=admin
LOAD_DB_PASSWORD=password123
LOAD_DB_SCHEMA=public                    # schema tabel raw_finance_* (dbt source 'raw')
LOAD_TIMEZONE=                           # batas bulan utk aturan "lewati bila tidak berubah";
                                         # kosong = REPORT_TIMEZONE, lalu Asia/Jakarta

# Relay Notifikasi (notif-relay) — webhook Airbyte (capil) → Telegram, sekaligus bot perintah
TELEGRAM_BOT_TOKEN=                       # token dari @BotFather
TELEGRAM_CHAT_ID=                         # id grup/chat tujuan (mis. -1001234567890);
                                          # hanya chat ini yang perintahnya dilayani
NOTIF_RELAY_PORT=8000                     # port relay (host & container); ganti bila port sudah dipakai layanan lain
TELEGRAM_MAX_RETRIES=3                    # jumlah percobaan kirim ke Telegram
TELEGRAM_RETRY_BACKOFF_SECONDS=3          # jeda backoff antar percobaan (linear)
TELEGRAM_BOT_ENABLED=true                 # false = hanya relay notifikasi, tanpa perintah
TELEGRAM_POLL_TIMEOUT=50                  # detik long-poll getUpdates
TELEGRAM_DM_USER_IDS=                     # id user (bukan grup) yang boleh memakai bot lewat
                                          # chat privat; pisah dengan koma. Ketik /id di grup
                                          # untuk melihat id Anda. Kosong = perintah hanya di grup
LOAD_CONTROL_URL=http://excel-loader:8080 # server kontrol job (internal gisnet);
                                          # SPLIT_CONTROL_URL lama diabaikan
DBT_CONTROL_URL=http://dbt-runner:8080
JOB_WATCH_ENABLED=true                    # lapor ke grup tiap run job selesai (termasuk run terjadwal)
JOB_WATCH_INTERVAL_SECONDS=10             # jeda cek status job
REKAP_ULANG_JAM=24                        # rekap masalah data keuangan yang sama diingatkan ulang tiap N jam
JOB_CONTROL_PORT=8080                     # port server kontrol di excel-loader & dbt-runner
JOB_LOG_LINES=200                         # baris log run terakhir yang disimpan di memori

# Mini App Telegram (panel /app) — kosongkan MINI_APP_URL kalau tidak dipakai
MINI_APP_URL=                             # URL HTTPS PUBLIK yang meneruskan ke /app relay ini
                                          # (reverse proxy/tunnel; Telegram menolak http://)
MINI_APP_DIRECT_LINK=                     # https://t.me/<bot>/<shortname> dari BotFather /newapp;
                                          # dipakai untuk tombol panel di dalam grup
MINI_APP_AUTH_MAX_AGE=86400               # umur maksimum initData (detik) sebelum panel minta dibuka ulang

# Laporan Rekap Bulanan (/laporan + tab Laporan di Mini App)
# Relay membaca warehouse langsung; defaultnya sudah cocok dengan compose stack ini,
# jadi biasanya tidak perlu diisi. Isi hanya kalau nama view/kredensialnya berbeda.
REPORT_DB_HOST=postgres-db                # host Postgres dari DALAM container relay
REPORT_DB_PORT=5432
REPORT_DB_NAME=capil_db
REPORT_DB_USER=admin
REPORT_DB_PASSWORD=password123
REPORT_SCHEMA=analytics
REPORT_VIEW_HIST_CAPIL=hist_capil         # view riwayat (semua tarikan) dari dbt/models/history/;
REPORT_VIEW_HIST_FINANCE_REKAP=hist_finance_rekap     # REPORT_VIEW_* lama (stg_all_*) tidak dipakai lagi
REPORT_VIEW_HIST_FINANCE_RINCIAN=hist_finance_rincian
REPORT_TIMEZONE=Asia/Jakarta              # batas akhir bulan: tarikan sebelum tgl 1 bulan depan (jam lokal)
REPORT_TEMPLATE=                          # kosong = docs/template/summary.xlsx bawaan image
REPORT_HISTORY_DIR=/data/laporan          # arsip potret bulanan (di-bind ke ./report-history);
                                          # dari sinilah baris JUMLAH BULAN LALU diisi
REPORT_XLSX_PASSWORD=                     # password untuk membuka .xlsx laporan; kosong = tanpa password

# Airbyte (perintah /sync, kini hanya koneksi capil) — kosongkan kalau tidak dipakai
AIRBYTE_URL=                              # URL yang terjangkau DARI container relay, bukan localhost
AIRBYTE_CLIENT_ID=                        # Airbyte UI → Settings → Applications
AIRBYTE_CLIENT_SECRET=
AIRBYTE_WORKSPACE_ID=                     # opsional, batasi daftar koneksi ke satu workspace

# Observability (Grafana / Prometheus / Loki)
GRAFANA_ADMIN_USER=admin                  # user login Grafana (http://localhost:3001)
GRAFANA_ADMIN_PASSWORD=admin              # ganti sebelum dipakai di luar localhost
