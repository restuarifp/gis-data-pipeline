# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Metabase
MB_DB_USER=
MB_DB_PASS=

# DBT
DBT_POSTGRES_USER=
DBT_POSTGRES_PW=
DBT_POSTGRES_DB=
DBT_POSTGRES_HOST=

# OnlyOffice
JWT_SECRET=

# Nextcloud WebDAV (split-excel)
NEXTCLOUD_URL=https://cloud.example.com
NEXTCLOUD_USER=
NEXTCLOUD_PASSWORD=
NEXTCLOUD_SOURCE_PATHS=/Uploads/Finance/kantorA,/Uploads/Finance/kantorB   # koma-separated; nama kantor = folder terakhir
# NEXTCLOUD_SOURCE_PATH juga diterima (alias, untuk satu atau beberapa path)
NEXTCLOUD_DEST_PATH=/Laporan-Split/      # folder hasil split, dibaca Airbyte
SCHEDULE_INTERVAL_MINUTES=60             # interval run (menit), sesuaikan dengan jadwal Airbyte

# Relay Notifikasi (notif-relay) — webhook Airbyte → Telegram
TELEGRAM_BOT_TOKEN=                       # token dari @BotFather
TELEGRAM_CHAT_ID=                         # id grup/chat tujuan (mis. -1001234567890)
NOTIF_RELAY_PORT=8000                     # port yang didengarkan relay (host & container)
TELEGRAM_MAX_RETRIES=3                    # jumlah percobaan kirim ke Telegram
TELEGRAM_RETRY_BACKOFF_SECONDS=3          # jeda backoff antar percobaan (linear)

# Observability (Grafana / Prometheus / Loki)
GRAFANA_ADMIN_USER=admin                  # user login Grafana (http://localhost:3001)
GRAFANA_ADMIN_PASSWORD=admin              # ganti sebelum dipakai di luar localhost
