FROM python:3.12-slim

WORKDIR /app

COPY scripts/requirements-notif-relay.txt .
RUN pip install --no-cache-dir -r requirements-notif-relay.txt

COPY scripts/notif_relay.py .
COPY scripts/report_summary.py .
# Halaman Mini App dilayani di GET /app oleh notif_relay.py
COPY scripts/miniapp.html .
# Template laporan. Path-nya sengaja meniru layout repo (../docs/template) supaya
# REPORT_TEMPLATE default di report_summary.py berlaku di container maupun lokal.
COPY docs/template/summary.xlsx /docs/template/summary.xlsx

CMD ["python", "notif_relay.py"]
